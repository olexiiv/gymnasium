---
layout: layouts/page.njk
permalink: /vstup/
eleventyComputed:
  title: "{{ vstup.title }}"
  intro: "{{ vstup.intro }}"
  description: "{{ vstup.description }}"
---
{% from "macros/icon.njk" import icon %}
{% from "macros/schema-faq.njk" import faqSchema %}

<section class="section">
  <div class="container container--narrow">

    <div class="notice notice--warm reveal">
      {{ icon("alert-circle", 22) }}
      {{ vstup.noticeTop | md | safe }}
    </div>

    <h2 class="section__title">{{ vstup.stepsTitle }}</h2>
    <ol class="steps">
      {% for step in vstup.steps %}
      <li class="steps__item reveal">
        <span class="steps__num" aria-hidden="true">{{ loop.index }}</span>
        <div>
          <h3>{{ step.title }}</h3>
          {{ step.text | md | safe }}
        </div>
      </li>
      {% endfor %}
    </ol>

    <div class="notice reveal">
      {{ icon("shield", 22) }}
      {{ vstup.noticeTot | md | safe }}
    </div>

    <h2 class="section__title">{{ vstup.faqTitle }}</h2>
    <div class="accordion">
      {% for item in vstup.faq %}
      <details class="accordion__item">
        <summary class="accordion__summary">{{ item.question }} {{ icon("chevron-down", 20, "accordion__chev") }}</summary>
        <div class="accordion__body">
          {{ item.answer | md | safe }}
        </div>
      </details>
      {% endfor %}
    </div>

    <div class="cta-box reveal">
      <h2>{{ vstup.ctaTitle }}</h2>
      <p>{{ vstup.ctaText }}</p>
      <div class="hero__actions">
        <a class="btn btn--brand" href="mailto:{{ site.admissionEmail }}">{{ icon("mail", 18) }} {{ site.admissionEmail }}</a>
        <a class="btn btn--ghost" href="/#contacts-title">Форма звʼязку</a>
      </div>
    </div>
  </div>
</section>

{{ faqSchema(vstup.faq, page.url, site.url) }}
