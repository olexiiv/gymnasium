{% from "macros/icon.njk" import icon %}
<section class="quick" aria-labelledby="quick-title">
  <div class="container">
    <h2 class="visually-hidden" id="quick-title">Швидкі дії</h2>
    <ul class="quick__grid">
      {% for q in home.quick %}
      <li>
        <a class="quick__card reveal" href="{{ q.url }}">
          <span class="quick__icon">{{ icon(q.icon or "arrow-right", 26) }}</span>
          <span class="quick__label">{{ q.label }}</span>
          <span class="quick__hint">{{ q.hint }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
