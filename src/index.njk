---
layout: layouts/base.njk
permalink: /
description: "Андріївська різнопрофільна гімназія (Запорізька область) — офіційний сайт. Релокований заклад працює дистанційно. Вступ, розклад, новини, психологічна підтримка, документи."
---
{% from "macros/icon.njk" import icon %}
{% from "macros/card-news.njk" import cardNews %}
{% from "macros/card-teacher.njk" import cardTeacher %}

{% include "partials/hero.njk" %}
{% include "partials/quick-actions.njk" %}

{# ---------- Про гімназію ---------- #}
<section class="section" aria-labelledby="about-title">
  <div class="container">
    <div class="about">
      <div class="about__text reveal">
        <p class="section__eyebrow">{{ home.about.eyebrow }}</p>
        <h2 class="section__title" id="about-title">{{ home.about.title }}</h2>
        {{ home.about.body | md | safe }}
        <a class="btn btn--ghost" href="{{ home.about.linkUrl }}">{{ home.about.linkLabel }} {{ icon("arrow-right", 18) }}</a>
      </div>
      <ul class="metrics" aria-label="Гімназія в цифрах">
        {% for m in site.metrics %}
        <li class="metrics__item reveal">
          <span class="metrics__icon">{{ icon(m.icon, 22) }}</span>
          <span class="metrics__value">{{ m.value }}</span>
          <span class="metrics__label">{{ m.label }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{# ---------- Новини ---------- #}
<section class="section section--alt" aria-labelledby="news-title">
  <div class="container">
    <div class="section__head">
      <div>
        <p class="section__eyebrow">{{ home.news.eyebrow }}</p>
        <h2 class="section__title" id="news-title">{{ home.news.title }}</h2>
      </div>
      <a class="btn btn--ghost" href="/novyny/">{{ home.news.linkLabel }} {{ icon("arrow-right", 18) }}</a>
    </div>
    <div class="grid grid--3">
      {% for post in collections.news | limit(3) %}
        {{ cardNews(post) }}
      {% endfor %}
    </div>
  </div>
</section>

{# ---------- Психологічна підтримка ---------- #}
<section class="section" aria-labelledby="support-title">
  <div class="container">
    <div class="support">
      <div class="support__intro reveal">
        <p class="section__eyebrow">{{ home.support.eyebrow }}</p>
        <h2 class="section__title" id="support-title">{{ home.support.title }}</h2>
        <p>{{ home.support.text }}</p>
      </div>
      <ul class="support__list">
        {% for s in site.support %}
        <li class="support__item reveal">
          <span class="support__icon">{{ icon(s.icon or "phone", 20) }}</span>
          <span class="support__name">{{ s.name }}</span>
          <a class="support__contact" href="{{ s.href }}"{% if s.external %} target="_blank" rel="noopener noreferrer"{% else %} rel="noopener"{% endif %}>{{ s.contact }}</a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{# ---------- Вчителі ---------- #}
<section class="section section--alt" aria-labelledby="teachers-title">
  <div class="container">
    <div class="section__head">
      <div>
        <p class="section__eyebrow">{{ home.teachers.eyebrow }}</p>
        <h2 class="section__title" id="teachers-title">{{ home.teachers.title }}</h2>
      </div>
      <a class="btn btn--ghost" href="/vchyteli/">{{ home.teachers.linkLabel }} {{ icon("arrow-right", 18) }}</a>
    </div>
    <div class="grid grid--4">
      {% for t in collections.teachers | limit(4) %}
        {{ cardTeacher(t) }}
      {% endfor %}
    </div>
  </div>
</section>

{# ---------- Життя гімназії ---------- #}
<section class="section" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section__head">
      <div>
        <p class="section__eyebrow">{{ home.gallery.eyebrow }}</p>
        <h2 class="section__title" id="gallery-title">{{ home.gallery.title }}</h2>
      </div>
    </div>
    <div class="masonry">
      {% for item in collections.gallery %}
      {% set base = item.data.image | replace(".webp", "") %}
      <figure class="masonry__item reveal">
        <button class="masonry__btn" type="button" data-lightbox
                data-caption="{{ item.data.caption }}"
                data-alt="{{ item.data.alt or item.data.caption }}"
                {% if item.data.image %}data-image="{{ item.data.image }}"{% endif %}
                aria-label="Відкрити фото: {{ item.data.caption }}">
          {% if item.data.image %}
            <img src="{% if item.data.width > 800 %}{{ base }}-800.webp{% else %}{{ item.data.image }}{% endif %}"
                 {% if item.data.width > 480 %}srcset="{{ base }}-480.webp 480w{% if item.data.width > 800 %}, {{ base }}-800.webp 800w{% endif %}, {{ item.data.image }} {{ item.data.width }}w"
                 sizes="(min-width: 1024px) 22rem, (min-width: 640px) 44vw, 90vw"{% endif %}
                 alt="{{ item.data.alt or item.data.caption }}"
                 width="{{ item.data.width or 480 }}" height="{{ item.data.height or 360 }}"
                 loading="lazy" decoding="async">
            <span class="masonry__zoom" aria-hidden="true">{{ icon("eye", 18) }}</span>
          {% else %}
            <span class="masonry__placeholder" style="--ratio: {{ item.data.ratio or '4 / 3' }}">
              {{ icon("image", 28) }}
              <span>[ФОТО: {{ item.data.caption }}]</span>
            </span>
          {% endif %}
        </button>
        <figcaption class="masonry__caption">{{ item.data.caption }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

{# ---------- Контакти ---------- #}
<section class="section section--alt" aria-labelledby="contacts-title">
  <div class="container">
    <div class="section__head">
      <div>
        <p class="section__eyebrow">{{ home.contacts.eyebrow }}</p>
        <h2 class="section__title" id="contacts-title">{{ home.contacts.title }}</h2>
      </div>
    </div>
    {% include "partials/contacts-block.njk" %}
  </div>
</section>
