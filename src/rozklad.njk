---
layout: layouts/page.njk
title: Розклад уроків
intro: Актуальний розклад по класах і розклад дзвінків.
description: "Розклад уроків Андріївської різнопрофільної гімназії по класах на 2026/2027 навчальний рік і розклад дзвінків."
permalink: /rozklad/
---
{% from "macros/icon.njk" import icon %}
<section class="section">
  <div class="container">
    <p class="schedule__updated">{{ icon("calendar", 18) }} {{ schedule.semester }} · оновлено {{ schedule.updatedAt | dateUA }}</p>

    {% if schedule.classes and schedule.classes.length %}

    {# Класів десять — без переходів сторінка гортається наосліп. #}
    <nav class="schedule__nav" aria-label="Перехід до класу">
      {% for cls in schedule.classes %}
      <a class="schedule__navlink" href="#{{ cls.id if cls.id else 'cls-' + loop.index }}">{{ cls.class }}</a>
      {% endfor %}
    </nav>

    {% for cls in schedule.classes %}
    {#- Сітка потрібна лише для рядка-попередження над таблицею: години
        уроків показуються один раз унизу сторінки, а не в кожній із
        десяти таблиць. -#}
    {%- set bellSet = schedule.bellSets | byId(cls.bellSet) -%}
    <section class="schedule reveal" id="{{ cls.id if cls.id else 'cls-' + loop.index }}" aria-labelledby="cls-{{ loop.index }}-title">
      <h2 class="schedule__class" id="cls-{{ loop.index }}-title">{{ cls.class }}</h2>

      {% if bellSet %}
      <p class="schedule__bellsnote">
        {{ icon("clock", 18) }}
        <span>Окрема сітка дзвінків: перший урок — {{ bellSet.bells[0].time }}.
        {{ bellSet.note }} <a href="#dzvinky">Повний перелік нижче</a>.</span>
      </p>
      {% endif %}

      {# Десктоп: таблиця. Мобільний: та сама розмітка перетворюється на картки по днях через CSS #}
      <div class="schedule__scroll">
        <table class="schedule__table">
          <caption class="visually-hidden">Розклад уроків, {{ cls.class }}</caption>
          <thead>
            <tr>
              <th scope="col">№</th>
              {% for d in cls.week %}<th scope="col">{{ d.day }}</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for lessonIdx in range(0, cls.week | maxLessons) %}
            <tr>
              <th scope="row"><span class="schedule__num">{{ loop.index }}</span></th>
              {% for d in cls.week %}
              <td data-day="{{ d.day }}">{{ d.lessons[lessonIdx] if d.lessons[lessonIdx] else "—" }}</td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endfor %}

    {% else %}
    <div class="notice notice--warm reveal">
      {{ icon("alert-circle", 22) }}
      <p><strong>{{ schedule.pendingTitle }}</strong> {{ schedule.pendingText }}</p>
    </div>
    {% endif %}

    <section class="section__sub" id="dzvinky" aria-labelledby="bells-title">
      <h2 class="section__title" id="bells-title">Розклад дзвінків</h2>

      {#- Підзаголовок «Загальний» має сенс лише тоді, коли поруч є окремі
          сітки; доки bellSets порожній, розділ виглядає як і раніше. -#}
      {% if schedule.bellSets and schedule.bellSets.length %}
      <h3 class="bells__group">Загальний</h3>
      {% endif %}
      {% if site.bellsNote %}<p class="bells__note">{{ icon("clock", 18) }} {{ site.bellsNote }}</p>{% endif %}
      <ul class="bells">
        {% for b in site.bells %}
        <li class="bells__item">
          <span class="bells__num">{{ b.n }} урок</span>
          <span class="bells__time">{{ b.time }}</span>
        </li>
        {% endfor %}
      </ul>

      {% for bellSet in schedule.bellSets %}
      <h3 class="bells__group">{{ bellSet.label }}</h3>
      {% if bellSet.note %}<p class="bells__note">{{ icon("clock", 18) }} {{ bellSet.note }}</p>{% endif %}
      <ul class="bells">
        {% for b in bellSet.bells %}
        <li class="bells__item">
          <span class="bells__num">{{ b.n }} урок</span>
          <span class="bells__time">{{ b.time }}</span>
        </li>
        {% endfor %}
      </ul>
      {% endfor %}
    </section>
  </div>
</section>
